# Copy this file to `backend/.env` and fill in your real values.
# `.env` is gitignored — never commit your password.

# The port the API listens on. Must match the URL in frontend/src/services/api.js.
PORT=5001

# MongoDB connection string.
#
# MongoDB Atlas (what this project uses) — get it from:
#   Atlas → your cluster → Connect → Drivers → Node.js
#
# Two things Atlas's copy-paste string will NOT have right:
#
#  1. <db_username>/<db_password> must be a DATABASE user, created under
#     Atlas → Database & Network Access. This is NOT your Atlas login.
#     Percent-encode any of  @ : / ? # [ ] %  in the password.
#
#  2. The database name goes between the "/" and the "?" — Atlas omits it.
#     This project uses `stsp_db`. Leave it out and Mongoose silently connects
#     to a default database called "test", where none of your data is.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/stsp_db?retryWrites=true&w=majority

# Local MongoDB instead, if you ever install one:
# MONGO_URI=mongodb://127.0.0.1:27017/stsp_db

# ---------------------------------------------------------------------------
# AI OCR (scripts/gemini_ocr.py)
# ---------------------------------------------------------------------------
# Required. The API shells out to scripts/gemini_ocr.py on every upload, and the
# google-genai client reads this variable to authenticate.
#
# Get one from https://aistudio.google.com/apikey
#
# Without it the upload still SUCCEEDS — the file is saved and a warning appears
# in the activity feed — but no fields are extracted.
GEMINI_API_KEY=

# Optional. Which Python interpreter runs the OCR script.
#
# Defaults to `python` on Windows and `python3` elsewhere. Set this if the
# default isn't on PATH, or to point at a virtualenv:
#
#   PYTHON_BIN=C:\Users\you\project\venv\Scripts\python.exe
#   PYTHON_BIN=/usr/bin/python3.12
#
# Check it works before blaming the app:
#   cd backend && python scripts/gemini_ocr.py "../driver's license test.pdf" driversLicense
# PYTHON_BIN=
